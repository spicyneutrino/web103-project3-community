{
  "name": "web103-project3-community",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/server.js",
    "db:seed": "node server/config/reset.js",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
